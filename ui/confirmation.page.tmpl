<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Confirm your registration</title>
</head>
<body style="font-family: Arial, sans-serif; background:#f4f4f4; padding:20px;">
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff; padding:30px; border-radius:8px;">

          <tr>
            <td align="center" style="font-size:24px; font-weight:bold; color:#333;">
              Welcome, {{.username}}!
            </td>
          </tr>

          <tr>
            <td style="padding-top:20px; font-size:16px; color:#555;">
              Thanks for registering. Please confirm your email address by clicking the button below:
            </td>
          </tr>

          <tr>
            <td align="center" style="padding:30px 0;">
              <a href="{{.confirm_link}}"
                 style="background:#4CAF50; color:#fff; padding:14px 28px; text-decoration:none; border-radius:5px; font-size:16px;">
                Confirm Email
              </a>
            </td>
          </tr>

          <tr>
            <td style="font-size:14px; color:#777;">
              If the button doesn't work, copy and paste this link into your browser:
              <br><br>
              <a href="{{.confirm_link}}">{{.confirm_link}}</a>
            </td>
          </tr>

          <tr>
            <td style="padding-top:30px; font-size:13px; color:#aaa;" align="center">
              If you didn’t create an account, you can safely ignore this email.
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
